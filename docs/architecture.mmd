    J --> L{"Rollback Verified?"}
    L -->|Yes| M["Record Failed Deployment"]
    L -->|No| N["Report Rollback Failure"]
    I --> O["Deployment History"]
    K --> O
    M --> O
    N --> O
    P["GitHub Actions"] --> Q["Run Unit Tests"]
